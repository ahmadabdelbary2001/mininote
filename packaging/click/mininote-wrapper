#!/bin/bash
# MiniNotes Ubuntu Touch launch wrapper
# Sets up the confined environment (Wayland, XDG dirs, library paths)
# then execs the Rust runner binary.
set -e

# Resolve the click root using only shell builtins.  Under the click AppArmor
# profile, executing helper binaries such as readlink(1), dirname(1) or
# mkdir(1) is denied, so the wrapper must not call them.
case "${0}" in
    /*)  HERE="${0%/*}" ;;
    */*) HERE="${PWD}/${0%/*}" ;;
    *)   HERE="${PWD}" ;;
esac

# If the launcher did not honour the desktop file's Path= key, fall back to
# the per-user click root before giving up.
if [ ! -d "${HERE}/lib" ] && [ -n "${APP_ID:-}" ]; then
    CLICK_ROOT="/opt/click.ubuntu.com/.click/users/@all/${APP_ID%%_*}"
    if [ -d "${CLICK_ROOT}/lib" ]; then
        HERE="${CLICK_ROOT}"
    fi
fi

# ---------------------------------------------------------------- libraries --
export LD_LIBRARY_PATH="${HERE}/lib:${HERE}:${LD_LIBRARY_PATH:-}"
export PATH="${HERE}:${PATH}"

# ------------------------------------------------- Wayland / EGL platform --
export EGL_PLATFORM="wayland"
export XDG_SESSION_TYPE="wayland"
export GDK_BACKEND="wayland"
export QT_QPA_PLATFORM="wayland"
export CLUTTER_BACKEND="wayland"
export SDL_VIDEODRIVER="wayland"
export FLUTTER_BUNDLE_DIR="${HERE}"

# ------------------------------------------------- Ubuntu Touch confinement --
# Confined packages can only write to:
#   $HOME/.local/share/<pkg>  (data)
#   $HOME/.cache/<pkg>        (cache)
#   $XDG_CACHE_HOME/tmp       (temporary files)
if [ -n "${APP_ID:-}" ]; then
    PKG_NAME="${APP_ID%%_*}"
else
    PKG_NAME="mininotes"
fi

export XDG_DATA_HOME="${HOME}/.local/share/${PKG_NAME}"
export XDG_CACHE_HOME="${HOME}/.cache/${PKG_NAME}"
# UID is a bash builtin; id(1) is not executable under the click profile.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/${UID}}"
# TMPDIR must be an existing writable directory.  Use the cache directory
# itself (the runner may refine this to <cache>/tmp and create it).
export TMPDIR="${XDG_CACHE_HOME}"
export XDG_DATA_DIRS="${HERE}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
# The directories are created by the Rust runner (std::fs::create_dir_all)
# because mkdir(1) is denied by the AppArmor policy.

# ---------------------------------------------------- Wayland display detect --
if [ -z "${WAYLAND_DISPLAY:-}" ]; then
    if [ -S "${XDG_RUNTIME_DIR}/wayland-0" ]; then
        export WAYLAND_DISPLAY="wayland-0"
    elif [ -S "${XDG_RUNTIME_DIR}/wayland-1" ]; then
        export WAYLAND_DISPLAY="wayland-1"
    fi
fi

# --------------------------------------------------------- Diagnostic mode --
if [ "${MININOTE_DEBUG:-0}" = "1" ] || [ "${DEBUG:-0}" = "1" ]; then
    export FLUTTER_LOG_LEVELS="${FLUTTER_LOG_LEVELS:-TRACE}"
    echo "=== [MiniNotes Diagnostic Startup] ==="
    echo "  APP_ID:           ${APP_ID:-<unset>}"
    echo "  BUNDLE_DIR:       ${FLUTTER_BUNDLE_DIR}"
    echo "  XDG_DATA_HOME:    ${XDG_DATA_HOME}"
    echo "  XDG_CACHE_HOME:   ${XDG_CACHE_HOME}"
    echo "  XDG_RUNTIME_DIR:  ${XDG_RUNTIME_DIR}"
    echo "  WAYLAND_DISPLAY:  ${WAYLAND_DISPLAY:-<unset>}"
    echo "  LOG_LEVEL:        ${FLUTTER_LOG_LEVELS}"
    echo ""
    echo "  === Runtime library check ==="
    for lib in \
        "${HERE}/lib/libflutter_engine.so" \
        "${HERE}/lib/libflutter_elinux_wayland.so" \
        "${HERE}/lib/libnative_core.so"; do
        if [ -f "$lib" ]; then
            echo "  [OK]     $lib"
        else
            echo "  [MISS]   $lib  - MISSING, the app will crash!"
        fi
    done
    if [ -f "${HERE}/lib/libapp.so" ]; then
        echo "  [OK]     ${HERE}/lib/libapp.so  (AOT release build)"
    else
        echo "  [INFO]   ${HERE}/lib/libapp.so  not present (JIT/debug mode)"
    fi
    echo "  === Flutter assets check ==="
    if [ -d "${HERE}/data/flutter_assets" ]; then
        echo "  [OK]     data/flutter_assets exists"
    else
        echo "  [MISS]   data/flutter_assets MISSING - the engine will abort!"
    fi
    if [ -f "${HERE}/data/icudtl.dat" ]; then
        echo "  [OK]     data/icudtl.dat exists"
    else
        echo "  [MISS]   data/icudtl.dat MISSING - ICU init will fail!"
    fi
    echo "======================================="
fi

# ----------------------------------------------------------------- launch --
exec "${HERE}/mininote" "$@"
