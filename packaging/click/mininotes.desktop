[Desktop Entry]
Name=MiniNote
Comment=MiniNote — Fast offline notes powered by Flutter + Rust
Exec=mininote-wrapper %U
Icon=assets/icons/mininotes.svg
Terminal=false
Type=Application
X-Ubuntu-Touch=true
X-Ubuntu-XMir-Enable=false
X-Ubuntu-Supported-Orientations=primary-portrait;portrait-inverted;landscape-primary;landscape-secondary
